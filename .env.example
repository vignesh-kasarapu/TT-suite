# TT Suite - local settings for `npm run suite:run`
# Copy to TT-suite/.env (git-ignored):  copy .env.example .env
# Works AS IS for a try-out: developer sign-in (pick a person), emails only recorded.
# For production: follow the comments - set the values marked 'production' and uncomment the <...> lines.
# A random secret:  docker run --rm alpine sh -c "head -c 32 /dev/urandom | base64"
# Generated from the maintainer's own file (same settings and order, secrets removed).

# without-resume branch: the Resume Evaluator is left out (remove this line to run it).
SUITE_SKIP=resume

# Local TT Suite settings, shared by all four processes (deploy/run.py loads this; gitignored).
# dev for a try-out; prod in production
APP_PROFILE=dev
# APP_PROFILE=prod   (production)
# dev = pick a person (no Microsoft needed); entra = Sign in with Microsoft
AUTH_PROVIDER=dev
# AUTH_PROVIDER=entra   (production)
# the local database from `npm run suite:db`
DATABASE_URL=postgresql://app_rw:dev@localhost:5433/ttsuite
# DATABASE_URL=postgresql://app_rw:<password>@<host>:5432/ttsuite   (production)
DATABASE_OWNER_URL=postgresql://app_owner:dev@localhost:5433/ttsuite
# DATABASE_OWNER_URL=postgresql://app_owner:<password>@<host>:5432/ttsuite   (production)
# any value locally; a long random one in production
INTERNAL_TOKEN=local-dev-internal-token
# INTERNAL_TOKEN=<long random value>   (production)
# SEED_GLOBAL_ADMIN_EMAIL=<first global admin work email>
PUBLIC_BASE_URL=http://localhost:8000
# PUBLIC_BASE_URL=https://<your host>   (production)

# Real mail through Kanban's mail stack (copied from Kanban-internal-main/Solution/.env)
# stub = emails only recorded; graph or smtp send real mail
MAIL_PROVIDER=stub
# MAIL_PROVIDER=graph   (production)
MAIL_FROM_NAME=Tektalis Suite
# ENTRA_TENANT_ID=<directory (tenant) id>
# ENTRA_CLIENT_ID=<application (client) id>
# ENTRA_CLIENT_SECRET=<client secret value>
# MAIL_SENDER=<sending mailbox, e.g. noreply@tektalis.com>
# MAIL_HOST=
MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# SMTP_FROM_ADDRESS=
SEED_FILE=deploy/seed.json
# false in production
AUTH_DEV_MODE=true
# AUTH_DEV_MODE=false   (production)
# ENTRA_REDIRECT_URI=<PUBLIC_BASE_URL>/api/auth/oidc/callback
# APP_SECRET=<32 random bytes, base64>
# SESSION_JWT_SECRET=<long random value>
# SUITE_HTTP_PORT=



# SECRET_KEY=
# ALGORITHM=
# ACCESS_TOKEN_EXPIRE_MINUTES=
 #resume evaluator
# COSINE_MATCH_THRESHOLD=
# COSINE_STRONG_THRESHOLD=
# SIMHASH_DUPLICATE_THRESHOLD=
 
# DEFAULT_WEIGHT_PROJECTS=
# DEFAULT_WEIGHT_SKILLS=
# DEFAULT_WEIGHT_EDUCATION=
 
# EMBEDDING_MODEL=
# UPLOAD_DIR=
# MAX_UPLOAD_MB=
 
# LLM scoring (leave LLM_API_KEY blank to use TF-IDF scorer instead)
# OpenAI:       LLM_BASE_URL=https://api.openai.com/v1       LLM_MODEL=gpt-4o-mini
# Anthropic:    LLM_BASE_URL=https://api.anthropic.com/v1    LLM_MODEL=claude-3-5-haiku-20241022
# Groq:         LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.1-8b-instant
# Together AI:  LLM_BASE_URL=https://api.together.xyz/v1     LLM_MODEL=mistralai/Mixtral-8x7B
# Ollama local: LLM_BASE_URL=http://localhost:11434/v1        LLM_MODEL=llama3
# Gemini AI:    LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/     LLM_MODEL=gemini-1.5-flash
 
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_TIMEOUT=
 

# IMAP_HOST=
# IMAP_PORT=
# IMAP_USERNAME=
# IMAP_PASSWORD=
# IMAP_SSL=
# IMAP_POLL_INTERVAL=
 

# ── Candidate Portal — PAN card encryption ───────────────────────────────────
# Generate key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank in dev to store PAN as plain text (not recommended for production)
# PAN_ENCRYPTION_KEY=
 

# ── GitHub enrichment (raises rate limit from 60 → 5000 req/hr) ──────────────
# GITHUB_TOKEN=
 
 


# --- kanban (moved from the app's own .env) ---
BODY_MAX_JSON=262144
RL_DEFAULT_IP=6000/min
RL_HEALTH_IP=60/min
RL_SIGNIN_IP=600/min
SESSION_HOURS=24

# --- lms (moved from the app's own .env) ---
DEFAULT_LEAVE_YEAR_START=04-01
DEFAULT_TIMEZONE=Asia/Kolkata
# ENTRA_MOBILE_CLIENT_ID=
# ENTRA_MOBILE_REDIRECT_URI=

# --- expense (moved from the app's own .env) ---
SCHEDULER_INTERVAL_MINUTES=60

# --- resume (Resume Evaluator) - optional; uncomment and fill in what you use ---
# The suite sets its database, port, links, SECRET_KEY and PAN_ENCRYPTION_KEY itself.
# SMTP_SERVER=
# SMTP_PORT=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# PREWARM_EMBEDDING=

# --- SharePoint: where every app stores uploaded attachments ---
# Folders: <App>/<EmployeeCode - Name>/<file>_<YYYY-MM-DD_HHMMSS>.<ext>, created on first upload.
# Uses ENTRA_TENANT_ID / ENTRA_CLIENT_ID / ENTRA_CLIENT_SECRET; the app registration needs the Microsoft Graph
# application permission Sites.ReadWrite.All (admin consent). Leave SHAREPOINT_SITE empty to keep files on disk.
# SHAREPOINT_SITE=tektalis.sharepoint.com:/sites/<YourSite>
# SHAREPOINT_LIBRARY=Documents
