# Copy to Solution/.env - `npm run trial:up` reads it by itself (Compose sets the rest in
# docker-compose.yml). The backend reads its settings in Solution/backend-py/app/core/config.py;
# the full list for host runs is Solution/backend-py/.env.example.
# No real secrets - placeholders only.

APP_PROFILE=dev
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
LOG_LEVEL=info

DATABASE_URL=postgres://app_rw:dev@localhost:5432/app
DATABASE_OWNER_URL=postgres://app_owner:dev@localhost:5432/app

# D-131: the one switch. true = dev picker (pick a name, no password; never in prod);
# false = Sign in with Microsoft (fill in the four ENTRA_* values). Leave AUTH_PROVIDER empty so it
# follows this switch; set it (dev | entra) only to override.
AUTH_DEV_MODE=true
AUTH_PROVIDER=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:8080/api/v1/auth/oidc/callback
SESSION_HOURS=24

# First admin, created at boot when missing (promoted to admin if present).
SEED_ADMIN_EMAIL=admin@example.test

RL_SIGNIN_IP=10/min
RL_HEALTH_IP=60/min
RL_DEFAULT_IP=600/min

BODY_MAX_JSON=262144

# Fixed "now" for dev/test (RFC 3339); refused in prod.
APP_FAKE_NOW=

# Email. stub = kept in the dev mailbox (/api/v1/dev/mail), never sent; graph = Microsoft Graph
# (needs Mail.Send as an Application permission); smtp = any SMTP server (D-132), e.g. Gmail with an
# app password: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587. Placeholders only - real values in .env.
MAIL_PROVIDER=stub
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
SMTP_FROM_ADDRESS=
MAIL_FROM_NAME=Tektalis Kanban
