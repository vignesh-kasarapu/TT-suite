# Kanban backend settings (app/core/config.py). Every key has a default for dev/test; the names
# and defaults are the deployment contract, unchanged by the move to Python (D-109).
# Secrets: DATABASE_URL, DATABASE_OWNER_URL, ENTRA_CLIENT_SECRET, APP_SECRET, INTERNAL_TOKEN -
# never commit them.

APP_PROFILE=dev                     # dev | test | prod (prod refuses every dev-only flag below)
PORT=8080                           # TT Suite: 8002 (set by deploy/run.py)
BIND_HOST=127.0.0.1                 # TT Suite: only the portal gateway talks to Kanban; 0.0.0.0 in a container
PUBLIC_BASE_URL=http://localhost:8080
LOG_LEVEL=info                      # trace | debug | info | warn | error | silent
APP_VERSION=dev

# Runtime role (pool of DB_POOL_SIZE) and the owner role (migrations only, closed after boot).
DATABASE_URL=postgres://app_rw:dev@localhost:5432/app
DATABASE_OWNER_URL=postgres://app_owner:dev@localhost:5432/app
DB_POOL_SIZE=5

# TT Suite: sign-in is the portal's (suite session cookie); AUTH_PROVIDER is always "suite".
AUTH_PROVIDER=suite
AUTH_DEV_MODE=false                 # "true" mounts POST /auth/dev/sign-in (never in prod)
INTERNAL_TOKEN=                     # shared secret for the portal's /internal/* calls; empty refuses all
ENTRA_TENANT_ID=                    # Graph only now (directory search, profile, mail)
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=                # the secret's VALUE, not its id
ENTRA_REDIRECT_URI=                 # unused since the TT Suite (sign-in is the portal's)
SESSION_HOURS=24                    # lifetime of a dev/test sign-in's suite session
SEED_ADMIN_EMAIL=                   # made admin at boot (created if absent)

RL_SIGNIN_IP=10/min                 # per-IP rate limits: N/min or N/hour
RL_HEALTH_IP=60/min
RL_DEFAULT_IP=600/min
BODY_MAX_JSON=262144                # bytes

APP_FAKE_NOW=                       # dev/test only: fixed "now", RFC 3339 (refused in prod)
ORG_TZ=Asia/Kolkata                 # IANA zone for "today" in reports (D-072)
MAIL_PROVIDER=stub                  # stub (dev/test) | graph (Microsoft Graph sendMail) | smtp (D-132)
MAIL_SENDER=kanban@example.test     # graph: the mailbox it sends from
MAIL_HOST=                          # smtp: e.g. smtp.gmail.com
MAIL_PORT=587                       # smtp: 587 (STARTTLS) or 465 (TLS)
MAIL_USERNAME=
MAIL_PASSWORD=                      # smtp: password / app password (secret)
SMTP_FROM_ADDRESS=                  # smtp: From address (default MAIL_USERNAME)
MAIL_FROM_NAME=Tektalis Kanban
APP_SECRET=                         # base64 of 32 random bytes; enables Teams webhooks and Entra sign-in
