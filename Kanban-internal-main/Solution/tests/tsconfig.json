{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "types.d.ts",
    "unit",
    "fixtures",
    "e2e/specs",
    "e2e/playwright.config.ts",
    "e2e/walkthrough",
    "e2e/walkthrough.config.ts"
  ]
}
