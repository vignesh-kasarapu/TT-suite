# Copy to .env and fill in. Use letters and digits only for POSTGRES_PASSWORD.
POSTGRES_USER=ams_user
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=ams_db

# Long random string, e.g. output of: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-long-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Port the app is published on, on the host machine.
APP_PORT=8080
# Comma-separated browser origins (only matters if the UI is served from another origin).
CORS_ORIGINS=http://localhost:8080

# Image to run (change if pulling from a registry, e.g. myregistry.azurecr.io/ams-app:1.0.0).
AMS_IMAGE=ams-app:latest
