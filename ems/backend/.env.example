# EMS (Expense) inside the TT Suite. deploy/run.py sets these in the suite; this file is for running EMS on its own.
APP_PROFILE=dev
# Runtime role (DML only) and the owner role that runs migrations (defaults to DATABASE_URL).
# Any postgres:// / postgresql:// URL works; the driver is normalised to postgresql+psycopg://.
# EMS tables live in schema "expense"; the suite identity tables in schema "suite".
DATABASE_URL=postgresql+psycopg://app_rw:dev@localhost:5433/ttsuite
DATABASE_OWNER_URL=postgresql+psycopg://app_owner:dev@localhost:5433/ttsuite
# PLACEHOLDER: shared secret for the portal -> EMS /internal/* routes (same value in every suite process).
INTERNAL_TOKEN=dev-internal-token
HOST=127.0.0.1
PORT=8004
UPLOAD_DIR=uploads
# Only needed when the SPA is served from another origin (the Vite dev server proxies, so normally not).
CORS_ORIGINS=http://localhost:5173
SCHEDULER_INTERVAL_MINUTES=60
