# LMS 2.0 backend (Python) — runs as the `lms` app of the TT Suite.
# See docs/SUITE-CONTRACT.md in the TT-suite checkout.

# Suite profile: dev | test | prod. (The legacy ENVIRONMENT=development|test|production
# is still accepted; APP_PROFILE wins when both are set.)
APP_PROFILE=dev

# uvicorn bind for `python -m app` — 127.0.0.1:8003 behind the portal gateway.
HOST=127.0.0.1
PORT=8003
APP_BASE_URL=http://localhost:8003
# Public URL of the LMS behind the gateway, for links in emails (prod: https://<site>/lms).
PUBLIC_BASE_URL=http://localhost:8000/lms
# Only used for CORS in dev (vite on :5173); the suite serves everything same-origin.
CLIENT_BASE_URL=http://localhost:5173

# --- Database: the suite's shared PostgreSQL; LMS tables live in schema `lms` ---
# Runtime role (DML only) and the owner role that runs Alembic + grants.
DATABASE_URL=postgresql://app_rw:dev@localhost:5433/ttsuite
DATABASE_OWNER_URL=postgresql://app_owner:dev@localhost:5433/ttsuite
DB_POOL_SIZE=5
# Fallback only when DATABASE_URL is unset:
# DB_HOST=localhost
# DB_PORT=5433
# DB_NAME=ttsuite
# DB_USER=app_rw
# DB_PASSWORD=dev
# DB_SSL=false

# --- Portal -> app internal routes (/internal/provision, /internal/authorize) ---
INTERNAL_TOKEN=change_me_shared_with_the_portal

# --- Storage for avatars + leave attachments (Azure: /home/data/lms) ---
# STORAGE_DIR=/home/data/lms

# --- Background jobs (APScheduler: SLA sweep, LOP sweep, digest, accrual, rollover) ---
SCHEDULER_ENABLED=true

# --- Mobile app only (web sign-in is the portal's) ---
# Entra ID public client for the Expo app's PKCE exchange (POST /api/auth/mobile/token).
ENTRA_TENANT_ID=
ENTRA_MOBILE_CLIENT_ID=
ENTRA_MOBILE_REDIRECT_URI=lms://auth
# Signs the mobile bearer token.
SESSION_JWT_SECRET=change_me_to_a_long_random_string
# Mobile dev login (POST /api/auth/dev-login -> bearer token). Refused at boot in prod.
DEV_AUTH_BYPASS_ENABLED=false
DEV_AUTH_BYPASS_EMPLOYEE_CODE=EMP001

# --- Outbound mail (SMTP). Empty MAIL_HOST = log instead of sending. ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
SMTP_FROM_ADDRESS=leave-system@yourorg.com

# --- Org defaults ---
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_LEAVE_YEAR_START=04-01
