# Defaults for `docker compose up` (try-out mode). Do not put secrets here: this file is in git.
# Your own settings go in .env.docker (copy deploy/docker.env.example); they override these.

# true  = try-out: developer sign-in (pick a person), emails only recorded, the demo people
# false = production: Sign in with Microsoft, real mail, strict checks at start
DEV_MODE=true

PUBLIC_BASE_URL=http://localhost:8000
INTERNAL_TOKEN=docker-demo-internal-token

# The built-in database (the `db` container). DATABASE_URL / DATABASE_OWNER_URL are built from
# these unless you set them yourself (e.g. to use Azure PostgreSQL).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ttsuite
DB_HOST=db
DB_PORT=5432
DB_OWNER_USER=app_owner
DB_OWNER_PASSWORD=dev
DB_APP_USER=app_rw
DB_APP_PASSWORD=dev

# without-resume branch: the suite runs without the Resume Evaluator and Asset Management (less memory).
SUITE_SKIP=resume,ams

ORG_TZ=Asia/Kolkata
DEFAULT_TIMEZONE=Asia/Kolkata
