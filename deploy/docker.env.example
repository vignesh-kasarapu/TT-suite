# Your settings for `docker compose up`. Copy this file to .env.docker in the TT-suite folder:
#     copy deploy\docker.env.example .env.docker        (Windows)
#     cp deploy/docker.env.example .env.docker          (Linux/macOS)
# .env.docker is git-ignored: secrets never reach the repository. Anything you set here overrides
# deploy/docker.defaults.env. With DEV_MODE=false the suite checks every setting below at start and
# refuses to run, listing what is missing, instead of running half-configured.
#
# Make a random secret (only Docker needed):
#     docker run --rm alpine sh -c "head -c 32 /dev/urandom | base64"

# ---- The switch --------------------------------------------------------------------------------
# true  = try-out: developer sign-in (pick a person), emails only recorded, demo people
# false = production: Sign in with Microsoft, real emails
DEV_MODE=false

# ---- Where people open the suite ---------------------------------------------------------------
# https:// in production (the sign-in cookie is Secure). http://localhost:8000 also works for a test.
PUBLIC_BASE_URL=https://suite.tektalis.com
# Only with the built-in HTTPS front end (docker compose --profile https up -d): the host name,
# which must point at this server; certificates are fetched automatically (ports 80 and 443).
SUITE_DOMAIN=suite.tektalis.com

# ---- Microsoft sign-in (the Entra app registration) --------------------------------------------
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Optional. Default: PUBLIC_BASE_URL + /api/auth/oidc/callback. Add exactly this redirect URI in
# Entra (App registrations > the app > Authentication > Web).
# ENTRA_REDIRECT_URI=

# ---- The first global admin (gets admin in every app on the first start) -----------------------
SEED_GLOBAL_ADMIN_EMAIL=

# ---- Secrets (each one a new random value, see the command at the top) -------------------------
APP_SECRET=
INTERNAL_TOKEN=
SESSION_JWT_SECRET=

# ---- Mail ---------------------------------------------------------------------------------------
# graph = a Microsoft 365 mailbox through the Entra app (needs the Mail.Send permission); or smtp
MAIL_PROVIDER=graph
MAIL_SENDER=
MAIL_FROM_NAME=Tektalis Suite
# smtp only:
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# SMTP_FROM_ADDRESS=

# ---- Database ----------------------------------------------------------------------------------
# A) The built-in database (the `db` container): choose strong passwords BEFORE the first start.
#    They are applied once, when the database volume is created; changing them later needs a new
#    volume (docker compose down -v deletes all data) or ALTER ROLE in psql.
POSTGRES_PASSWORD=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
# B) Your own PostgreSQL (e.g. Azure Flexible Server): set both URLs; they win over the values
#    above. Start only the suite: docker compose up -d --no-deps app
# DATABASE_URL=postgresql://kanban_app:PASSWORD@myserver.postgres.database.azure.com:5432/kanban?sslmode=require
# DATABASE_OWNER_URL=postgresql://kanban_owner:PASSWORD@myserver.postgres.database.azure.com:5432/kanban?sslmode=require

# --- SharePoint: where every app stores uploaded attachments ---
# Folders: <App>/<EmployeeCode - Name>/<file>_<YYYY-MM-DD_HHMMSS>.<ext>, created on first upload.
# Uses ENTRA_TENANT_ID / ENTRA_CLIENT_ID / ENTRA_CLIENT_SECRET; the app registration needs the Microsoft Graph
# application permission Sites.ReadWrite.All (admin consent). Leave SHAREPOINT_SITE empty to keep files on disk.
# SHAREPOINT_SITE=tektalis.sharepoint.com:/sites/TTSuite
# SHAREPOINT_LIBRARY=Documents
